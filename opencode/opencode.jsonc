          "name": "Claude Sonnet 4.6 [Sinara]",
        },
        "sinara.ai/bedrock/qwen.qwen3-coder-next": {
          "name": "Qwen 3 Coder Next [Sinara]",
        },
        "sinara.ai/bedrock/google.gemma-3-4b-it": {
          "name": "Gemma 3 [Sinara]",
        },
      },
      "options": {
        "baseURL": "https://bifrost.lab.sarsoo.xyz/v1",
      },
    },
  },
}
