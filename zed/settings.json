// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true
  },
  "colorize_brackets": true,
  "agent_servers": {
    "opencode": {
      "favorite_models": [
        "sarsoo-ai/sinara.ai/bedrock/qwen.qwen3-coder-next"
      ],
      "type": "registry"
    }
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "allow_data_collection": "no",
    "enabled_in_text_threads": true,
    "open_ai_compatible_api": {
      "model": "sinara.ai/bedrock/qwen.qwen3-coder-next",
      "api_url": "https://bifrost.lab.sarsoo.xyz/v1",
      "prompt_format": "infer"
    },
    "provider": "open_ai_compatible_api"
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "outline_panel": {
    "dock": "left",
    "file_icons": true
  },
  "project_panel": {
    "sort_mode": "directories_first",
    "hide_root": true,
    "diagnostic_badges": true,
    "bold_folder_labels": true,
    "indent_size": 15.0,
    "git_status": true,
    "folder_icons": false,
    "file_icons": true,
    "entry_spacing": "standard",
    "dock": "left"
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.7
  },
  "tabs": {
    "show_diagnostics": "errors",
    "file_icons": true,
    "git_status": true
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
    "show_user_menu": true,
    "show_sign_in": false
  },
  "status_bar": {
    "line_endings_button": true,
    "active_encoding_button": "enabled"
  },
  "use_smartcase_search": true,
  "inlay_hints": {
    "enabled": true
  },
  "vim": {
    "toggle_relative_line_numbers": false
  },
  "relative_line_numbers": "disabled",
  "vim_mode": false,
  "ui_font_family": ".ZedSans",
  "buffer_line_height": "comfortable",
  "buffer_font_family": ".ZedMono",
  "languages": {
    "PowerShell": {
      "tab_size": 4
    },
    "HCL": {
      "colorize_brackets": true,
      "inlay_hints": {
        "enabled": true
      }
    }
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": false
    }
  },
  "prettier": {
    "allowed": true
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "git": {
    "enable_diff": true,
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "tab_size": 2,
  "ssh_connections": [
    {
      "host": "penfold",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/admin_ajp/dev"
          ]
        },
        {
          "paths": [
            "/home/andy.pack/iac"
          ]
        }
      ]
    },
    {
      "host": "annex.sinara.net",
      "username": "admin_ajp",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/admin_ajp/iac"
          ]
        }
      ]
    }
  ],
  "disable_ai": false,
  "terminal": {
    "cursor_shape": "bar",
    "font_family": ".ZedMono",
    "working_directory": "current_file_directory",
    "dock": "bottom",
    "toolbar": {
      "breadcrumbs": true,
    },
  },
  "agent": {
    "auto_compact": {
      "threshold": "90%"
    },
    "dock": "right",
    "default_model": {
      "provider": "sarsoo-ai",
      "model": "sinara.ai/bedrock/qwen.qwen3-coder-next",
      "enable_thinking": true
    },
    "button": true,
    "favorite_models": [
      {
        "provider": "sarsoo-ai",
        "model": "sinara.ai/bedrock/qwen.qwen3-coder-next",
        "enable_thinking": true
      }
    ],
    "model_parameters": [],
  },
  "git_panel": {
    "show_count_badge": true,
    "file_icons": true,
    "diff_stats": true,
    "sort_by_path": true,
    "status_style": "icon",
    "button": true,
    "tree_view": true,
    "dock": "right",
  },
  "bottom_dock_layout": "contained",
  "show_whitespaces": "selection",
  "indent_guides": {
    "background_coloring": "indent_aware",
  },
  "soft_wrap": "editor_width",
  "minimap": {
    "display_in": "active_editor",
    "show": "always",
  },
  "autosave": "off",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
  "ui_font_size": 15.0,
  "buffer_font_size": 11.0,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Frappé",
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
      "**/values*.yaml"
    ]
  },
  "lsp": {
    "terraform-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true
        }
      }
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemas": {
            "https://raw.githubusercontent.com/compose-spec/compose-go/master/schema/compose-spec.json": "docker-compose*.yml"
          }
        }
      }
    }
  },
  "auto_install_extensions": {
    "ansible": true,
    "basher": true,
    "csharp": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "helm": true,
    "html": true,
    "ini": true,
    "just": true,
    "latex": true,
    "log": true,
    "nginx": true,
    "powershell": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "rose-pine-theme": true,
    "catppuccin": true,
    "catppuccin-icons": true
  },
  "language_models": {
    "openai_compatible": {
      // Using Together AI as an example
      "sarsoo.chat": {
        "api_url": "https://bifrost.lab.sarsoo.xyz/v1",
        "available_models": [
          {
            "name": "sarsoo-ai/sinara.ai/bedrock/qwen.qwen3-coder-next",
            "display_name": "Qwen 3 Coder Next [Sinara]",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true
            }
          }
        ]
      }
    }
  }
}
