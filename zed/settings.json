            "/home/admin_ajp/iac/lib/k8s",
            "/home/admin_ajp/iac/lib/helm",
          ],
        },
        {
          "paths": [
            "/home/admin_ajp/iac/onprem-artifacts",
            "/home/admin_ajp/iac/onprem-cicd",
            "/home/admin_ajp/iac/onprem-monitoring",
            "/home/admin_ajp/iac/onprem-k8s",
          ],
        },
        {
          "paths": ["/home/admin_ajp/iac/sales-iac"],
        },
      ],
      "nickname": "annex",
    },
  ],
  "disable_ai": false,
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "/bin/bash", // or path to your preferred shell
        "args": ["-c", "tmux new-session -A -s \"zed-$(basename \"$PWD\")\""],
      },
    },
    "cursor_shape": "bar",
    "font_family": "JetBrains Mono",
    "font_fallbacks": ["JetBrains Mono", ".ZedMono"],
    "working_directory": "current_file_directory",
    "dock": "bottom",
    "toolbar": {},
  },
  "agent": {
    "notify_when_agent_waiting": "all_screens",
    "sidebar_side": "right",
    "auto_compact": {
      "threshold": "90%",
    },
    "dock": "right",
    "default_model": {
      "provider": "sarsoo-ai",
      "model": "opencode-go/qwen3.7-plus",
      "enable_thinking": true,
    },
    "button": true,
    "favorite_models": [
      {
        "provider": "sarsoo-ai",
        "model": "opencode-go/qwen3.7-plus",
        "enable_thinking": true,
      },
    ],
    "model_parameters": [],
  },
  "git_panel": {
    "entry_primary_click_action": "file_diff",
    "group_by": "staging",
    "show_count_badge": true,
    "file_icons": true,
    "diff_stats": true,
    "sort_by_path": true,
    "status_style": "label_color",
    "button": true,
    "tree_view": true,
    "dock": "right",
  },
  "bottom_dock_layout": "contained",
  "show_whitespaces": "all",
  "indent_guides": {
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },
  "soft_wrap": "editor_width",
  "minimap": {
    "display_in": "all_editors",
    "show": "always",
  },
  "autosave": "off",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
  "ui_font_size": 15.0,
  "buffer_font_size": 11.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
  "file_types": {
    "Helm": [
      "helmfile.yaml",
      "helmfile.yml",
      "Chart.yaml",
      "Chart.yml",
      "Chart.lock",
      "requirements.yaml",
      "requirements.yml",
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
    ],
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/playbooks/*.yaml",
      "**/playbooks/*.yml",
      "**playbook*.yaml",
      "**playbook*.yml",
    ],
    "Jinja2": ["*.j2"],
    "Dockerfile": ["Dockerfile.*", "*.Dockerfile", "*.dockerfile", "*.Docker"],
  },
  "lsp": {
    "terraform-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true,
        },
      },
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemas": {
            "https://raw.githubusercontent.com/compose-spec/compose-go/master/schema/compose-spec.json": "docker-compose*.yml",
            "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/inventory.json": [
              "./inventory/*.yaml",
              "hosts.yml",
            ],
          },
          "format": {
            "bracketSpacing": false,
          },
        },
      },
    },
    "helm": {
      "settings": {
        "helm-ls": {
          "logLevel": "info",
          "yamlls": {
            "enabled": true,
          },
        },
      },
    },
  },
  "auto_install_extensions": {
    "ansible": true,
    "basher": true,
    "csharp": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "helm": true,
    "html": true,
    "ini": true,
    "just": true,
    "latex": true,
    "log": true,
    "nginx": true,
    "powershell": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "rose-pine-theme": true,
    "catppuccin": true,
    "catppuccin-icons": true,
  },
  "language_models": {
    "openai_compatible": {
      // Using Together AI as an example
      "sarsoo.chat": {
        "api_url": "https://bifrost.lab.sarsoo.xyz/v1",
        "available_models": [
          {
            "name": "sarsoo-ai/opencode-go/qwen3.7-plus",
            "display_name": "Qwen 3.7",
            "max_tokens": 64000,
            "max_output_tokens": 64000,
            "max_completion_tokens": 64000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
          },
        ],
      },
    },
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/bin",
    "**/obj",
    "**/.terraform",
    "**/.venv",
    "**/.env/**",
  ],
}
