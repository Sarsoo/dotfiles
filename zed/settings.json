// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "scrollbar": {
    "axes": {
      "horizontal": false,
    },
  },
  "use_system_window_tabs": false,
  "focus_follows_mouse": {
    "debounce_ms": 0,
    "enabled": true,
  },
  "seed_search_query_from_cursor": "selection",
  "completions": {
    "lsp_insert_mode": "replace",
  },
  "lsp_results_location": "multi_buffer",
  "middle_click_paste": false,
  "code_lens": "on",
  "completion_menu_item_kind": "symbol",
  "line_ending": "prefer_lf",
  "toolbar": {
    "code_actions": true,
  },
  "gutter": {
    "min_line_number_digits": 4,
  },
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "default_open_behavior": "new_window",
  "format_on_save": "on",
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "colorize_brackets": true,
  "agent_servers": {
    "herm": {
      "type": "custom",
      "command": "ssh",
      "args": ["herm", "/home/hermes/.local/bin/hermes", "acp"],
    },
    "opencode": {
      "env": {
        "AWS_CONFIG_FILE": "~/.aws/config.readonly",
      },
      "favorite_config_option_values": {
        "model": [
          "sarsoo-ai/opencode-go/deepseek-v4-flash",
          "sarsoo-ai/bedrock/anthropic.claude-sonnet-5",
          "sarsoo-ai/opencode-go/qwen3.7-plus",
          "sarsoo-ai/opencode-go/glm-5.2",
        ],
      },
      "default_config_options": {
        "mode": "plan",
        "model": "sarsoo-ai/opencode-go/qwen3.7-plus",
      },
      "type": "registry",
    },
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "allow_data_collection": "no",
    "open_ai_compatible_api": {
      "max_output_tokens": 64,
      "model": "opencode-go/qwen3.7-plus",
      "api_url": "https://bifrost.lab.sarsoo.xyz/v1",
      "prompt_format": "qwen",
    },
    // "provider": "open_ai_compatible_api",
    "provider": "none",
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "outline_panel": {
    "dock": "left",
    "file_icons": true,
  },
  "project_panel": {
    "hide_hidden": false,
    "sort_mode": "directories_first",
    "hide_root": true,
    "diagnostic_badges": true,
    "bold_folder_labels": true,
    "indent_size": 15.0,
    "git_status": true,
    "folder_icons": false,
    "file_icons": true,
    "entry_spacing": "standard",
    "dock": "left",
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.7,
  },
  "tabs": {
    "show_diagnostics": "errors",
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
    "show_user_menu": true,
    "show_sign_in": false,
  },
  "status_bar": {
    "line_endings_button": true,
    "active_encoding_button": "enabled",
  },
  "use_smartcase_search": true,
  "inlay_hints": {
    "edit_debounce_ms": 200,
    "show_background": true,
    "enabled": true,
  },
  "vim": {
    "toggle_relative_line_numbers": false,
  },
  "relative_line_numbers": "disabled",
  "vim_mode": false,
  "ui_font_family": "Fraunces",
  "ui_font_fallbacks": [".ZedSans"],
  "buffer_line_height": "standard",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_fallbacks": [".ZedMono"],
  "languages": {
    "YAML": {
      "format_on_save": "off",
      "prettier": {
        "bracketSpacing": false,
      },
    },
    "Helm": {
      "format_on_save": "on",
    },
    "PowerShell": {
      "tab_size": 4,
    },
    "HCL": {
      "colorize_brackets": true,
      "inlay_hints": {
        "enabled": true,
      },
    },
    "Ansible": {
      "semantic_tokens": "combined",
    },
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": false,
    },
  },
  "prettier": {
    "allowed": true,
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "git": {
    "file_diff": {
      "show_full_file": false,
    },
    "blame": {
      "show_avatar": false,
    },
    "enable_diff": true,
    "inline_blame": {
      "location": "inline",
      "show_commit_summary": true,
    },
  },
  "tab_size": 2,
  "ssh_connections": [
    {
      "host": "annex.sinara.net",
      "username": "admin_ajp",
      "args": [],
      "projects": [
        {
          "paths": ["/home/admin_ajp/dev"],
        },
        {
          "paths": [
            "/home/admin_ajp/dev/lme/smart",
            "/home/admin_ajp/iac/lmesmart-iac",
          ],
        },
        {
          "paths": [
            "/home/admin_ajp/dev/tlc/comet",
            "/home/admin_ajp/iac/comet-iac",
            "/home/admin_ajp/dev/tlc/comet-qa",
          ],
        },
        {
          "paths": [
            "/home/admin_ajp/dev/tlc/redkite",
            "/home/admin_ajp/iac/redkite-iac",
          ],
        },
        {
          "paths": [
            "/home/admin_ajp/dotfiles",
            "/home/admin_ajp/dev/scripts",
            "/home/admin_ajp/scripts",
          ],
        },
        {
          "paths": ["/home/admin_ajp/iac"],
        },
        {
          "paths": ["/home/admin_ajp/iac/ansible"],
        },
        {
          "paths": [
            "/home/admin_ajp/iac/aws-artifacts",
