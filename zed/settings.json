// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "on",
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "colorize_brackets": true,
  "agent_servers": {
    "herm": {
      "type": "custom",
      "command": "ssh",
      "args": ["herm", "/home/hermes/.local/bin/hermes", "acp"],
    },
    "opencode": {
      "env": {
        "AWS_CONFIG_FILE": "~/.aws/config.readonly",
      },
      "favorite_config_option_values": {
        "model": [
          "sarsoo-ai/opencode-go/deepseek-v4-flash",
          "sarsoo-ai/bedrock/anthropic.claude-sonnet-5",
          "sarsoo-ai/opencode-go/qwen3.7-plus",
          "sarsoo-ai/opencode-go/glm-5.2",
        ],
      },
      "default_config_options": {
        "model": "sarsoo-ai/opencode-go/qwen3.7-plus",
      },
      "type": "registry",
    },
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "allow_data_collection": "no",
    "open_ai_compatible_api": {
      "max_output_tokens": 64,
      "model": "opencode-go/qwen3.7-plus",
      "api_url": "https://bifrost.lab.sarsoo.xyz/v1",
      "prompt_format": "qwen",
    },
    // "provider": "open_ai_compatible_api",
    "provider": "none",
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "outline_panel": {
    "dock": "left",
    "file_icons": true,
  },
  "project_panel": {
    "sort_mode": "directories_first",
    "hide_root": true,
    "diagnostic_badges": true,
    "bold_folder_labels": true,
    "indent_size": 15.0,
    "git_status": true,
    "folder_icons": false,
    "file_icons": true,
    "entry_spacing": "standard",
    "dock": "left",
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.7,
  },
  "tabs": {
    "show_diagnostics": "errors",
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
    "show_user_menu": true,
    "show_sign_in": false,
  },
  "status_bar": {
    "line_endings_button": true,
    "active_encoding_button": "enabled",
  },
  "use_smartcase_search": true,
  "inlay_hints": {
    "enabled": true,
  },
  "vim": {
    "toggle_relative_line_numbers": false,
  },
  "relative_line_numbers": "disabled",
  "vim_mode": false,
  "ui_font_family": "Fraunces",
  "ui_font_fallbacks": [".ZedSans"],
  "buffer_line_height": "comfortable",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_fallbacks": [".ZedMono"],
  "languages": {
    "PowerShell": {
      "tab_size": 4,
    },
    "HCL": {
      "colorize_brackets": true,
      "inlay_hints": {
        "enabled": true,
      },
    },
    "Ansible": {
      "semantic_tokens": "combined",
    },
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": false,
    },
  },
  "prettier": {
    "allowed": true,
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "git": {
    "enable_diff": true,
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "tab_size": 2,
  "ssh_connections": [
    {
      "host": "annex.sinara.net",
      "username": "admin_ajp",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/admin_ajp/dev/scripts"
          ]
        },
        {
          "paths": [
            "/home/admin_ajp/dev/tlc/comet"
          ]
        },
        {
          "paths": [
            "/home/admin_ajp/dotfiles"
          ]
        },
        {
          "paths": [
            "/home/admin_ajp/iac"
          ]
        },
        {
          "paths": [
            "/home/admin_ajp/iac/lib/aws"
          ]
        },
        {
          "paths": [
            "/home/admin_ajp/iac/sales-iac"
          ]
        },
        {
          "paths": [
            "/home/admin_ajp/scripts"
          ]
        }
      ],
      "nickname": "annex"
    }
  ],
  "disable_ai": false,
  "terminal": {
    "cursor_shape": "bar",
    "font_family": "JetBrains Mono",
    "font_fallbacks": [".ZedMono"],
    "working_directory": "current_file_directory",
    "dock": "bottom",
    "toolbar": {
      "breadcrumbs": true,
    },
  },
  "agent": {
    "sidebar_side": "right",
    "auto_compact": {
      "threshold": "90%",
    },
    "dock": "right",
    "default_model": {
      "provider": "sarsoo-ai",
      "model": "opencode-go/qwen3.7-plus",
      "enable_thinking": true,
    },
    "button": true,
    "favorite_models": [
      {
        "provider": "sarsoo-ai",
        "model": "opencode-go/qwen3.7-plus",
        "enable_thinking": true,
      },
    ],
    "model_parameters": [],
  },
  "git_panel": {
    "group_by": "staging",
    "show_count_badge": true,
    "file_icons": true,
    "diff_stats": true,
    "sort_by_path": true,
    "status_style": "icon",
    "button": true,
    "tree_view": true,
    "dock": "right",
  },
  "bottom_dock_layout": "contained",
  "show_whitespaces": "selection",
  "indent_guides": {
    "background_coloring": "indent_aware",
  },
  "soft_wrap": "editor_width",
  "minimap": {
    "display_in": "active_editor",
    "show": "always",
  },
  "autosave": "off",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
  "ui_font_size": 15.0,
  "buffer_font_size": 11.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
  "file_types": {
    "Helm": [
      "helmfile.yaml",
      "helmfile.yml",
      "Chart.yaml",
      "Chart.yml",
      "Chart.lock",
      "requirements.yaml",
      "requirements.yml",
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
    ],
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/playbooks/*.yaml",
      "**/playbooks/*.yml",
      "**playbook*.yaml",
      "**playbook*.yml",
    ],
    "Dockerfile": ["Dockerfile.*", "*.Dockerfile", "*.dockerfile", "*.Docker"],
  },
  "lsp": {
    "terraform-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true,
        },
      },
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemas": {
            "https://raw.githubusercontent.com/compose-spec/compose-go/master/schema/compose-spec.json": "docker-compose*.yml",
          },
          "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/inventory.json": [
            "./inventory/*.yaml",
            "hosts.yml",
          ],
        },
      },
    },
    "helm": {
      "settings": {
        "helm-ls": {
          "logLevel": "info",
          "yamlls": {
            "enabled": true,
          },
        },
      },
    },
  },
  "auto_install_extensions": {
    "ansible": true,
    "basher": true,
    "csharp": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "helm": true,
    "html": true,
    "ini": true,
    "just": true,
    "latex": true,
    "log": true,
    "nginx": true,
    "powershell": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "rose-pine-theme": true,
    "catppuccin": true,
    "catppuccin-icons": true,
  },
  "language_models": {
    "openai_compatible": {
      // Using Together AI as an example
      "sarsoo.chat": {
        "api_url": "https://bifrost.lab.sarsoo.xyz/v1",
        "available_models": [
          {
            "name": "sarsoo-ai/opencode-go/qwen3.7-plus",
            "display_name": "Qwen 3.7",
            "max_tokens": 64000,
            "max_output_tokens": 64000,
            "max_completion_tokens": 64000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
          },
        ],
      },
    },
  },
}
