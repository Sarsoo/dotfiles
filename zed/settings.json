// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "languages": {
    "HCL": {
      "colorize_brackets": true,
      "inlay_hints": {
        "enabled": true
      }
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "prettier": {
    "allowed": true
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "tab_size": 2,
  "ssh_connections": [
    {
      "host": "penfold",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/andy.pack/iac"
          ]
        }
      ]
    }
  ],
  "disable_ai": true,
  "terminal": {
    "toolbar": {
      "breadcrumbs": true,
    },
  },
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right",
  },
  "bottom_dock_layout": "contained",
  "show_whitespaces": "selection",
  "indent_guides": {
    "background_coloring": "indent_aware",
  },
  "soft_wrap": "editor_width",
  "minimap": {
    "show": "always",
  },
  "autosave": "off",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 15.0,
  "buffer_font_size": 11.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "auto_install_extensions": {
    "ansible": true,
    "basher": true,
    "csharp": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "helm": true,
    "html": true,
    "just": true,
    "latex": true,
    "log": true,
    "nginx": true,
    "powershell": true,
    "sql": true,
    "terraform": true,
  },
}
