{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "mouse": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "tps": true
  },
  "animations": true,
  "theme": {
    "name": "catppuccin-frappe"
  },
  "cursor": {
    "style": "line",
    "blinking": true
  },
  "tabs": {
    "mode": "auto",
    "scope": "global",
    "layout": "horizontal",
    "indicators": "status"
  },
  "plugins": ["./herdr-opencode"]
}
