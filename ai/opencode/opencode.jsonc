{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/dev",
  "default_agent": "plan",
  "formatter": true,
  "providers": {
    "openai": {
      "name": "openai.sarsoo",
      "settings": {
        "baseURL": "https://bifrost.lab.sarsoo.xyz/openai",
        "includeUsage": true,
      },
      "models": {
        // GOOGLE
        "gemma-4-e2b": {
          "modelID": "gemma-4-e2b",
          "name": "Gemma 4",
          "capabilities": {
            "tools": false,
          },
          "cost": {
            "input": 0.04,
            "output": 0.08,
          },
        },
        // DEEPSEEK
        "dev": {
          "modelID": "dev",
          "name": "Dev",
          "capabilities": {
            "tools": true,
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
          "cost": {
            "input": 0.3,
            "output": 1.2,
            "cache": {
              "read": 0.006,
            },
          },
        },
        // OPENAI
        "gpt-flash": {
          "name": "GPT-Flash",
          "capabilities": {
            "tools": true,
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "cost": {
            "input": 0.1,
            "output": 0.5,
            "cache": {
              "read": 0.01,
              "write": 0.125,
            },
          },
        },
        "gpt-medium": {
          "name": "GPT-Medium",
          "capabilities": {
            "tools": true,
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "cost": {
            "input": 2.0,
            "output": 10.0,
            "cache": {
              "read": 0.1,
              "write": 2.5,
            },
          },
        },
      },
    },
    "anthropic": {
      "name": "anthropic.sarsoo",
      "settings": {
        "baseURL": "https://bifrost.lab.sarsoo.xyz/anthropic/v1",
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Opus",
          "cost": {
            "input": 4,
            "output": 20,
            "cache": {
              "read": 0.2,
              "write": 5,
            },
          },
        },
        "claude-sonnet-5-5": {
          "name": "Sonnet",
          "cost": {
            "input": 2.0,
            "output": 10,
            "cache": {
              "read": 0.1,
              "write": 2.5,
            },
          },
        },
        "claude-haiku-5-5": {
          "name": "Haiku",
          "cost": {
            "input": 0.1,
            "output": 0.5,
            "cache": {
              "read": 0.01,
              "write": 0.125,
            },
          },
        },
      },
    },
  },
  // "lsp": true,
  "lsp": false,
  "permission": {
    "*": "ask",
    "external_directory": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "lsp": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "sort *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "wc -l *": "allow",
      "echo *": "allow",
      "test *": "allow",
      "printf *": "allow",
      "wc *": "allow",
      "exit": "allow",
      "exit *": "allow",
      "file *": "allow",
      "sleep *": "allow",
      "true *": "allow",
      "dos2unix *": "allow",
      "unix2dos *": "allow",
      "cmp *": "allow",

      "rm *": "ask",
      "rmdir *": "ask",
      "terraform plan *": "allow",
      "terraform fmt *": "allow",
      "terraform validate *": "allow",
      "aws *": "ask",

      "git *": "deny",
      "git status": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git log": "allow",
      "git diff *": "allow",
      "git diff": "allow",
      "git show *": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git tag": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git describe": "allow",
      "git describe *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git blame": "allow",
      "git blame *": "allow",
      "git grep": "allow",
      "git grep *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
    },
  },
  "agents": {
    "build": {},
    "plan": {},
    "general": {},
    "explore": {},
    "scout": {},
    "compaction": {
      "model": "openai/gemma-4-e2b",
    },
    "title": {
      "model": "openai/gemma-4-e2b",
    },
    "summary": {
      "model": "openai/gemma-4-e2b",
    },
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "environment": {
          "CODEGRAPH_TELEMETRY": "0",
        },
      },
      // "terraform": {
      //   "type": "local",
      //   "command": [
      //     "docker",
      //     "run",
      //     "-i",
      //     "--rm",
      //     "hashicorp/terraform-mcp-server:1.0.0",
      //   ],
      //   "enabled": true,
      // },
      // "aws": {
      //   "type": "local",
      //   "command": [
      //     "uvx",
      //     "mcp-proxy-for-aws==1.6.2",
      //     "https://aws-mcp.eu-central-1.api.aws/mcp",
      //     "--region",
      //     "eu-west-2",
      //     // "--read-only",
      //     "--metadata",
      //     "AWS_REGION=eu-west-2",
      //   ],
      //   "enabled": true,
      //   "environment": {
      //     "AWS_MCP_PROXY_PROFILES": "sinara_ttm_dev_readonly sinara_ttm_mirror_readonly sinara_tlc_demo_readonly sinara_sandbox_readonly sinara_terraform_readonly sinara_artifacts_readonly sinara_tlc_terraform_readonly sinara_tlc_artifacts_readonly sinara_tlc_artillery_readonly sinara_identity_readonly sinara_observability_readonly sinara_dns_readonly sinara_organisation_readonly sinara_eng_llm_readonly sinara_artifacts_readonly sinara_tlc_artifacts_readonly sinara_ipam_readonly sinara_audit_readonly sinara_cloudwatch_readonly sinara_remoteaccess_readonly sinara_secops_readonly sinara_backup_readonly",
      //     "AWS_REGION": "eu-west-2",
      //   },
      // },
      // "grafana": {
      //   "type": "local",
      //   "command": ["mcp-grafana"],
      //   "enabled": true,
      //   "environment": {
      //     "GRAFANA_URL": "https://grafana.techops.sinara.cloud",
      //     "GRAFANA_SERVICE_ACCOUNT_TOKEN": "eu-west-2",
      //   },
      // },
    },
  },
  "share": "disabled",
}
