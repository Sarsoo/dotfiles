{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/deepseek-v4.1-flash",
  "default_agent": "plan",
  "formatter": true,
  "providers": {
    "openai": {
      "name": "openai.sarsoo",
      "options": {
        "baseURL": "https://bifrost.lab.sarsoo.xyz/openai",
        "headers": {
          "x-opencode-git-username": "{env:GIT_USERNAME}",
          "x-opencode-git-branch": "{env:GIT_BRANCH}",
          "x-opencode-git-repo-url": "{env:GIT_REPO_URL}",
          "x-opencode-git-repo-fullurl": "{env:GIT_REPO_URL}/{env:GIT_BRANCH}",
        },
        "includeUsage": true,
      },
      "models": {
        // GOOGLE
        "gemma-3-4b-it": {
          "name": "Gemma 3",
          "tool_call": false,
          "reasoning": false,
        },
        "gemma-4-e2b": {
          "name": "Gemma 4",
          "tool_call": false,
          "reasoning": false,
        },
        // GLM
        "glm-5.3": {
          "name": "GLM 5.3",
          "tool_call": true,
          "reasoning": true,
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "tool_call": true,
          "reasoning": true,
        },
        // MOONSHOT
        "kimi-k3": {
          "name": "Kimi K3",
          "tool_call": true,
          "reasoning": true,
        },
        // DEEPSEEK
        "deepseek-v4.1-flash": {
          "name": "Deepseek v4.1 Flash",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
      },
    },
    "anthropic": {
      "name": "anthropic.sarsoo",
      "options": {
        "baseURL": "https://bifrost.lab.sarsoo.xyz/anthropic/v1",
        "headers": {
          "anthropic-version": "2023-06-01",
          "x-opencode-git-username": "{env:GIT_USERNAME}",
          "x-opencode-git-branch": "{env:GIT_BRANCH}",
          "x-opencode-git-repo-url": "{env:GIT_REPO_URL}",
          "x-opencode-git-repo-fullurl": "{env:GIT_REPO_URL}/{env:GIT_BRANCH}",
        },
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Opus",
          "cost": {
            "input": 4,
            "output": 20,
            "cache": {
              "read": 0.2,
              "write": 5,
            },
          },
          "thinking": { "type": "adaptive" },
          "variants": {
            "Low": { "output_config": { "effort": "low" } },
            "Medium": { "output_config": { "effort": "medium" } },
            "High": { "output_config": { "effort": "high" } },
            "Max": { "output_config": { "effort": "max" } },
          },
        },
        "claude-sonnet-5-5": {
          "name": "Sonnet",
          "cost": {
            "input": 2.0,
            "output": 10,
            "cache": {
              "read": 0.1,
              "write": 2.5,
            },
          },
          "thinking": { "type": "adaptive" },
          "variants": {
            "Low": { "output_config": { "effort": "low" } },
            "Medium": { "output_config": { "effort": "medium" } },
            "High": { "output_config": { "effort": "high" } },
            "Max": { "output_config": { "effort": "max" } },
          },
        },
        "claude-haiku-5-5": {
          "name": "Haiku",
          "cost": {
            "input": 0.1,
            "output": 0.5,
            "cache": {
              "cache_read": 0.01,
              "cache_write": 0.125,
            },
          },
        },
      },
    },
  },
  "command": {},
  // "lsp": true,
  "lsp": false,
  "permission": {
    "*": "ask",
    "external_directory": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "lsp": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "sort *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "wc -l *": "allow",
      "echo *": "allow",
      "test *": "allow",
      "printf *": "allow",
      "wc *": "allow",
      "exit": "allow",
      "exit *": "allow",
      "file *": "allow",
      "sleep *": "allow",
      "true *": "allow",
      "dos2unix *": "allow",
      "unix2dos *": "allow",
      "cmp *": "allow",

      "rm *": "ask",
      "rmdir *": "ask",
      "terraform plan *": "allow",
      "terraform fmt *": "allow",
      "terraform validate *": "allow",
      "aws *": "ask",

      "git *": "deny",
      "git status": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git log": "allow",
      "git diff *": "allow",
      "git diff": "allow",
      "git show *": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git tag": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git describe": "allow",
      "git describe *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git blame": "allow",
      "git blame *": "allow",
      "git grep": "allow",
      "git grep *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
    },
  },
  "agent": {
    "build": {},
    "plan": {},
    "general": {},
    "explore": {},
    "scout": {},
    "compaction": {
      "model": "openai/gemma-4-e2b",
    },
    "title": {
      "model": "openai/gemma-4-e2b",
    },
    "summary": {
      "model": "openai/gemma-4-e2b",
    },
  },
  "share": "disabled",
}
