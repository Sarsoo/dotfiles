unameOut="$(uname -s)"
case "${unameOut}" in
    Linux*)     machine=Linux;;
    Darwin*)    machine=Mac;;
    CYGWIN*)    machine=Cygwin;;
    MINGW*)     machine=MinGw;;
    MSYS_NT*)   machine=MSys;;
    *)          machine="UNKNOWN:${unameOut}"
esac

export EDITOR=vim
# PS1='%F{green}%n@%m%f %1/ %F{red}%#%f '

################
# ALIASES
################

alias mkdir='mkdir -p'
alias cp="cp -i" # confirm before overwriting something
alias free='free -m' # show sizes in MB
alias df='df -h' # human-readable sizes
alias more=less

alias lasterror='journalctl -p 3 -xb'
alias mtr='mtr -b -o "LSRD NABWV G JMXI"'

alias gitlog='git log --graph --all --oneline'
alias rdoc='cargo doc --open'
alias dbx='distrobox'

command -v nvim >/dev/null 2>&1 && alias vim='nvim'

##
# util
##

if command -v mpv >/dev/null 2>&1; then
  alias ytmpv='mpv --hwdec=auto --ytdl-format="bestvideo+bestaudio/best"'
  alias ytmpvqhd='mpv --hwdec=auto --ytdl-format="bestvideo[height<=?1800]+bestaudio/best"'
  alias ytmpvhd='mpv --hwdec=auto --ytdl-format="bestvideo[height<=?1080]+bestaudio/best"'
fi

[[ -d "${HOME}/dev/infra/ansible" ]] && alias cdans='cd "${HOME}/dev/infra/ansible"'
[[ -d "${HOME}/lab/infra/ansible" ]] && alias cdans='cd "${HOME}/lab/infra/ansible"'
[[ -d "${HOME}/lab/nix" ]] && alias cdnix='cd "${HOME}/lab/nix"'

if command -v podman >/dev/null 2>&1 && ! command -v docker >/dev/null 2>&1; then
  alias docker='podman'
fi

alias vjau='vja ls -u'

##
# terraform
##
alias tf='terraform'
alias tfi='terraform init'
alias tfu='terraform init -upgrade'
alias tfa='terraform apply'
alias tfp='terraform plan'
alias tfg='terraform get -update'
alias tfia='terraform init && terraform apply'
alias tfip='terraform init && terraform plan'
alias tfv='terraform validate'
alias tfiv='terraform init -backend=false && terraform validate'
alias tfl='tflint --recursive --init --format compact'

##
# k8s
##
alias k='kubectl'

################
# MAC
################
if [[ "${machine}" = "Mac" ]]; then
    alias cdicloud='cd ~/Library/Mobile\ Documents/com\~apple\~CloudDocs'
    alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
fi

################
# PATH
################

paths=(
    '/opt/homebrew/opt/python/bin'
    "${HOME}/bin"
    "${HOME}/.local/bin"
    "${HOME}/.dotnet/tools"
    "${HOME}/.kubectx"
    "${HOME}/.opencode/bin"
    "${HOME}/.krew/bin"
)
for p in "${paths[@]}"; do
    if [ -d "${p}" ]; then
        export PATH="${p}:${PATH}"
    fi
done

################
# SUB-RC
################

if [[ -d "${HOME}/.local/rc.d" ]]; then

  while IFS= read -r -d '' line; do
      source "${line}"
  done < <(find "${HOME}/.local/rc.d" -type f,l -name '*.sh' -print0)
fi

[[ -e "${HOME}/.cargo/env" ]] && source "${HOME}/.cargo/env"
[[ -d "${HOME}/.scripts" ]] && source "${HOME}/.scripts/.rc"
[[ -e "${HOME}/scripts/.rc" ]] && source "${HOME}/scripts/.rc"
