{
  "theme": "dark",
  "file_browser": {
    "show_hidden": true
  },
  "file_explorer": {
    "show_gitignored": true
  },
  "editor": {
    "completion_popup_auto_show": true,
    "cursor_jump_animation": false,
    "cursor_style": "blinking_bar"
  },
  "plugins": {
    "dashboard": {
      "settings": {
        "autoOpen": false
      },
      "enabled": true
    },
    "vi_mode": {
      "enabled": true,
      "settings": {
        "autoStart": false,
        "arrowKeys": true,
        "searchWordUnderCursor": true
      }
    }
  },
  "version": 2,
  "keybindings": [
    {
      "key": "o",
      "modifiers": ["alt"],
      "action": "orchestrator_dock_toggle"
    },
    {
      "key": "o",
      "modifiers": ["alt"],
      "action": "orchestrator_dock_toggle",
      "when": "global"
    },
    {
      "key": "o",
      "modifiers": ["alt"],
      "action": "noop",
      "when": "fileExplorer"
    },
    {
      "key": "o",
      "modifiers": ["alt"],
      "action": "noop",
      "when": "dock"
    },
    {
      "key": "o",
      "modifiers": ["alt"],
      "action": "noop",
      "when": "compositeBuffer"
    },
    {
      "key": "o",
      "modifiers": ["alt"],
      "action": "noop",
      "when": "prompt"
    },
    {
      "key": "o",
      "modifiers": ["alt"],
      "action": "noop",
      "when": "terminal"
    },
    {
      "key": "o",
      "modifiers": ["alt"],
      "action": "orchestrator_open",
      "when": "global"
    },
    {
      "key": "Tab",
      "modifiers": ["alt"],
      "action": "next_window",
      "when": "global"
    },
    {
      "key": "Tab",
      "modifiers": ["alt"],
      "action": "next_buffer",
      "when": "global"
    },
    {
      "key": "{",
      "modifiers": ["alt"],
      "action": "prev_buffer",
      "when": "normal"
    },
    {
      "key": "}",
      "modifiers": ["alt"],
      "action": "next_buffer",
      "when": "global"
    },
    {
      "key": "{",
      "modifiers": ["alt"],
      "action": "prev_buffer",
      "when": "global"
    },
    {
      "key": "e",
      "modifiers": ["ctrl"],
      "action": "noop",
      "when": "normal"
    },
    {
      "key": "n",
      "modifiers": ["ctrl"],
      "action": "new",
      "when": "terminal"
    }
  ]
}
